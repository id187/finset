{
  "name": "finset-mockup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "vite preview --host 127.0.0.1 --mode pages",
    "test:model": "node --experimental-strip-types --test tests/model.test.mjs",
    "test:pages": "node --experimental-strip-types --test tests/pages.test.mjs tests/guided.test.mjs",
    "test:guided": "node --experimental-strip-types --test tests/guided.test.mjs",
    "test:ui": "node scripts/audit-mockup.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "@fontsource-variable/noto-sans-kr": "^5.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
